{
    "name": "cleanvote",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "deploy": "run-p deploy:client deploy:server",
        "deploy:client": "run-s build-client && wrangler pages deploy client/dist",
        "deploy:server": "wrangler deploy server/src/index.ts --minify",
        "serve": "run-p client server",
        "client": "cd client && vite --port 4000",
        "server": "wrangler dev server/src/index.ts",
        "build-client": "cd client && tsc -b && vite build",
        "lint": "eslint ."
    },
    "dependencies": {
        "@zod/mini": "^4.0.0-beta.0",
        "hono": "^4.13.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.2",
        "react-turnstile": "^1.1.5"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260702.1",
        "@eslint/js": "^9.39.5",
        "@types/bun": "^1.4.0",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.15.0",
        "npm-run-all": "^4.1.5",
        "sass-embedded": "^1.103.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^6.4.3",
        "wrangler": "^4.125.0"
    }
}
